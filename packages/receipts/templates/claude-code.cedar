    || context.args.command like "*rm -fR ~/ *"
    || context.args.command like "*rm -fR ~/\*"
    || context.args.command like "*rm -r -f ~"
    || context.args.command like "*rm -r -f ~ *"
    || context.args.command like "*rm -r -f ~/"
    || context.args.command like "*rm -r -f ~/ *"
    || context.args.command like "*rm -r -f ~/\*"
    || context.args.command like "*rm -f -r ~"
    || context.args.command like "*rm -f -r ~ *"
    || context.args.command like "*rm -f -r ~/"
    || context.args.command like "*rm -f -r ~/ *"
    || context.args.command like "*rm -f -r ~/\*"
    || context.args.command like "*rm -R -f ~"
    || context.args.command like "*rm -R -f ~ *"
    || context.args.command like "*rm -R -f ~/"
    || context.args.command like "*rm -R -f ~/ *"
    || context.args.command like "*rm -R -f ~/\*"
    || context.args.command like "*rm -f -R ~"
    || context.args.command like "*rm -f -R ~ *"
    || context.args.command like "*rm -f -R ~/"
    || context.args.command like "*rm -f -R ~/ *"
    || context.args.command like "*rm -f -R ~/\*"
  )
};

