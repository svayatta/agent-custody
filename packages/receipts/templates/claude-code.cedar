// Starter policy for `agent-custody init claude-code`.
// The policy permits every call and forbids a short list of destructive Bash commands.
// A pattern matches the text of the command. It is not a sandbox: it catches the plain form of each command.
// Each rule has a `@reason`. The hook shows it to the agent and to the person who reads the session.
// The `like` operator is case-sensitive, and `*` is its only wildcard, so each SQL keyword has a rule for each case.
// A rule id is the place of the rule in this file (policy1, policy2, and so on). Change a rule in place. Add a new rule
// at the end, so that an id keeps naming the same rule.
permit(principal, action, resource);

// Rewriting shared history.
// `--force-with-lease` is a force push that fails when the remote has new commits. The policy allows it.
// A force push has `--force`, `-f`, or a refspec that starts with `+`, such as `git push origin +main`. The push can
// be `git push` or `git -C <dir> push`.
// `like` cannot find where one shell command ends. So a flag counts in three cases: it is the first argument of the
// push, or no `&`, `|`, `;`, or newline follows the push, or one of them follows the flag. In
// `git push origin main && npm install --force` the flag comes after the operator, and the command passes. A chain with
// two operators after the push can be denied by mistake: `git push && npm install --force && echo done`.

@reason("force push rewrites shared history (git push --force-with-lease is allowed)")
forbid(principal, action == Action::"Bash", resource)
when {
  context.args has command && (
    context.args.command like "*git push --force *"
    || context.args.command like "*git push --force"
    || context.args.command like "*git push -f*"
    || context.args.command like "*git push +*"
    || context.args.command like "*git -* push --force *"
    || context.args.command like "*git -* push --force"
    || context.args.command like "*git -* push -f*"
    || context.args.command like "*git -* push +*"
    || (!(context.args.command like "*git push*&*" || context.args.command like "*git push*|*" || context.args.command like "*git push*;*" || context.args.command like "*git push*\n*") && (
      context.args.command like "*git push* --force *"
      || context.args.command like "*git push* --force"
      || context.args.command like "*git push* -f*"
      || context.args.command like "*git push* +*"
    ))
    || (!(context.args.command like "*git -* push*&*" || context.args.command like "*git -* push*|*" || context.args.command like "*git -* push*;*" || context.args.command like "*git -* push*\n*") && (
      context.args.command like "*git -* push* --force *"
      || context.args.command like "*git -* push* --force"
      || context.args.command like "*git -* push* -f*"
      || context.args.command like "*git -* push* +*"
    ))
    || context.args.command like "*git push* --force *&*"
    || context.args.command like "*git push* --force&*"
    || context.args.command like "*git push* -f*&*"
    || context.args.command like "*git push* +*&*"
    || context.args.command like "*git push* --force *|*"
    || context.args.command like "*git push* --force|*"
    || context.args.command like "*git push* -f*|*"
    || context.args.command like "*git push* +*|*"
    || context.args.command like "*git push* --force *;*"
    || context.args.command like "*git push* --force;*"
    || context.args.command like "*git push* -f*;*"
    || context.args.command like "*git push* +*;*"
    || context.args.command like "*git push* --force *\n*"
    || context.args.command like "*git push* --force\n*"
    || context.args.command like "*git push* -f*\n*"
    || context.args.command like "*git push* +*\n*"
    || context.args.command like "*git -* push* --force *&*"
    || context.args.command like "*git -* push* --force&*"
    || context.args.command like "*git -* push* -f*&*"
    || context.args.command like "*git -* push* +*&*"
    || context.args.command like "*git -* push* --force *|*"
    || context.args.command like "*git -* push* --force|*"
    || context.args.command like "*git -* push* -f*|*"
    || context.args.command like "*git -* push* +*|*"
    || context.args.command like "*git -* push* --force *;*"
    || context.args.command like "*git -* push* --force;*"
    || context.args.command like "*git -* push* -f*;*"
    || context.args.command like "*git -* push* +*;*"
    || context.args.command like "*git -* push* --force *\n*"
    || context.args.command like "*git -* push* --force\n*"
    || context.args.command like "*git -* push* -f*\n*"
    || context.args.command like "*git -* push* +*\n*"
  )
};

// Deleting the root directory or the home directory.
// The flags are -rf, -fr, -Rf, -fR, and the separate forms -r -f, -f -r, -R -f, -f -R. The target is the directory, the
// directory with more arguments after it, or all its files (`/*`). The home directory may be quoted: `"$HOME"`.
@reason("rm -rf on the root directory")
forbid(principal, action == Action::"Bash", resource)
when {
  context.args has command && (
    context.args.command like "*rm -rf /"
    || context.args.command like "*rm -rf / *"
    || context.args.command like "*rm -rf /\*"
    || context.args.command like "*rm -fr /"
    || context.args.command like "*rm -fr / *"
    || context.args.command like "*rm -fr /\*"
    || context.args.command like "*rm -Rf /"
    || context.args.command like "*rm -Rf / *"
    || context.args.command like "*rm -Rf /\*"
    || context.args.command like "*rm -fR /"
    || context.args.command like "*rm -fR / *"
    || context.args.command like "*rm -fR /\*"
    || context.args.command like "*rm -r -f /"
    || context.args.command like "*rm -r -f / *"
    || context.args.command like "*rm -r -f /\*"
    || context.args.command like "*rm -f -r /"
    || context.args.command like "*rm -f -r / *"
    || context.args.command like "*rm -f -r /\*"
    || context.args.command like "*rm -R -f /"
    || context.args.command like "*rm -R -f / *"
    || context.args.command like "*rm -R -f /\*"
    || context.args.command like "*rm -f -R /"
    || context.args.command like "*rm -f -R / *"
    || context.args.command like "*rm -f -R /\*"
  )
};

@reason("rm -rf on the home directory")
forbid(principal, action == Action::"Bash", resource)
when {
