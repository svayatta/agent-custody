# Copy to .env. The .env file is gitignored; nothing here is committed.

# The published receipts version to build the image from.
AGENT_CUSTODY_VERSION=0.10.0

# Bearer token the gateway and SDK present on append. Generate one: openssl rand -hex 32
# Give it to the operator as the value of the environment variable their config names in log.tokenEnv.
AGENT_CUSTODY_LOG_TOKEN=

# The id written into every tree head this log signs; verifiers check it with --log-id. Use the public host.
AGENT_CUSTODY_LOG_ID=log.example.com

# Shared secret between the log and the signer: openssl rand -hex 32
SIGNER_TOKEN=

# The operator's admin page, at https://<ADMIN_HOST>/ and at https://<LOG_HOST>/admin, needs this token: openssl rand -hex 32.
# Leave empty for no admin page.
ADMIN_TOKEN=
# The admin page's own host (A record to this VM); optional, the page is also under LOG_HOST/admin.
ADMIN_HOST=

# Public hosts for the --profile public setup; Caddy obtains certificates for both.
LOG_HOST=log.example.com
CHECKPOINTS_HOST=checkpoints.example.com

# Seconds between checkpoint publications.
AGENT_CUSTODY_CHECKPOINT_EVERY=300

# Postgres password for the leaves, tenants, and tokens store: openssl rand -hex 24
POSTGRES_PASSWORD=

# Where backup-offsite.sh mirrors /var/backups/agent-custody every night, as an rclone remote path; the script refuses
# to run without it. Examples: hetzner:agent-custody-backups (S3), storagebox:backups/agent-custody (sftp).
BACKUP_REMOTE=

# The tenant portal at PORTAL_HOST (A record to this VM). PORTAL_SECRET signs sessions: openssl rand -hex 32.
PORTAL_HOST=
PORTAL_SECRET=
# Billing through Stripe: the secret key (add it with `read -s`), then ./stripe-setup.sh fills in the price id and the
# webhook signing secret after creating both in Stripe.
# All three or none; without them the portal runs with card payments off and says so.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
# Mail at registration, through Resend (https://resend.com): an API key, a sender address on a domain verified there
# (an address only, no display name), and optionally an operator address that gets a note per registration.
# Unset, no mail is sent and registration works the same.
MAIL_API_KEY=
MAIL_FROM=
MAIL_NOTIFY=
# Sign in with GitHub or Google: an OAuth app per provider whose callback is https://<PORTAL_HOST>/auth/<provider>/callback.
# Unset, the portal offers email and password only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The documentation site at DOCS_HOST (A record to this VM), built from this checkout by deploy/update-docs.sh.
DOCS_HOST=
