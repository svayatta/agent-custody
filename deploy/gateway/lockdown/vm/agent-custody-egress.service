# The egress witness on a plain VM, beside the gateway (../../agent-custody-gateway.service), for agents locked down by
# agent-lockdown.nft and agent-lockdown.conf. It uses the same egress.json and egress-policy.cedar as the compose and
# Kubernetes recipes: the unit mounts /etc/agent-custody/egress at /egress and its state directory at /data, the paths
# in that config. It runs as a user of its own, so it cannot read the gateway's key or the credentials the gateway holds.
#
#   sudo useradd --system --home /var/lib/agent-custody-egress --create-home --shell /usr/sbin/nologin custody-egress
#   sudo install -d /etc/agent-custody/egress && sudo cp ../config/egress.json ../config/egress-policy.cedar /etc/agent-custody/egress/
#   sudo install -m 0600 /dev/null /etc/agent-custody/egress.env     # EGRESS_SECRET_RESEARCH_AGENT=<openssl rand -hex 32>
#   sudo install -d -o custody-egress -g custody-egress /var/lib/agent-custody-egress/keys
#   sudo -u custody-egress agent-custody keygen --dir /var/lib/agent-custody-egress/keys --name egress
#   sudo systemctl enable --now agent-custody-egress
#
# Receipts are written to /var/lib/agent-custody-egress/receipts.
[Unit]
Description=agent-custody egress witness
After=network-online.target
Wants=network-online.target

[Service]
User=custody-egress
# only the agents' proxy secrets: the witness holds no tool credential
EnvironmentFile=/etc/agent-custody/egress.env
ExecStart=/usr/bin/env agent-custody egress --config /egress/egress.json --host 127.0.0.1 --port 8791
Restart=on-failure
RestartSec=5
# SIGTERM receipts the open tunnels as witness-stopped before the witness exits
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
BindReadOnlyPaths=/etc/agent-custody/egress:/egress
BindPaths=/var/lib/agent-custody-egress:/data
# The witness already refuses internal addresses for a host name. This also keeps it off the link-local range, where
# a cloud VM's metadata service answers (169.254.169.254), whatever the policy says.
IPAddressDeny=link-local

[Install]
WantedBy=multi-user.target
