# Copy to .env on the witness's machine. This machine and this account must not be the log operator's.
AGENT_CUSTODY_VERSION=0.13.0
WITNESS_HOST=witness.example.org
WITNESS_LOG_URL=https://log.example.com/
WITNESS_CHECKPOINTS_URL=https://checkpoints.example.com/
# space- or comma-separated tenants to watch; "default" is the log's root paths
WITNESS_TENANTS=default
WITNESS_EVERY=300
